<mvc:View
  controllerName="de.web1.smartstock.controller.Orders"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page title="Bestellungen">
    <subHeader>
      <Toolbar>
        <Button text="Dashboard" icon="sap-icon://business-objects-experience" press=".onNavDashboard" />
        <Button text="Lager" icon="sap-icon://inventory" press=".onNavInventory" />
        <ToolbarSpacer />
        <Button text="Analyse" icon="sap-icon://business-objects-mobile" press=".onNavAnalytics" />
        <Button text="System" icon="sap-icon://sys-monitor" press=".onNavSystem" />
      </Toolbar>
    </subHeader>
    <content>
      <Panel class="smartPanel">
        <headerToolbar>
          <Toolbar>
            <VBox>
              <Label text="Nachbestellungen · /orders" class="sectionEyebrow" />
              <Title text="Bestellvorgänge" level="H2" />
            </VBox>
            <ToolbarSpacer />
            <Select width="12rem" selectedKey="{/filters/orderStatus}" change=".onOrderStatusFilterChange">
              <items>
                <core:Item key="offen" text="Offen" />
                <core:Item key="geliefert" text="Geliefert" />
                <core:Item key="storniert" text="Storniert" />
                <core:Item key="all" text="Alle" />
              </items>
            </Select>
            <Button text="CSV exportieren" icon="sap-icon://download" type="Emphasized" press=".onExportOrders" />
          </Toolbar>
        </headerToolbar>
        <content>
          <HBox wrap="Wrap">
            <List items="{/filteredOrders}" class="orderList">
              <CustomListItem>
                <VBox class="orderItem">
                  <HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap">
                    <ObjectIdentifier title="{productName}" text="{detailText}" />
                    <VBox class="orderActions">
                      <ObjectStatus text="{orderStatusText}" state="{orderStatusState}" />
                      <ObjectStatus text="{priorityText}" state="{priorityState}" />
                    </VBox>
                  </HBox>
                  <HBox wrap="Wrap" class="orderMeta">
                    <Text text="Lieferant: {supplier}" />
                    <Text text="Bestellt: {createdAtText}" />
                    <Text text="Erwartet: {expectedAtText}" />
                    <Text text="Geliefert: {completedAtText}" visible="{= !!${completedAtText} }" />
                    <Text text="{receivedQuantityText}" visible="{= !!${receivedQuantityText} }" />
                    <Text text="Storniert: {cancelledAtText}" visible="{= !!${cancelledAtText} }" />
                  </HBox>
                  <HBox wrap="Wrap" class="orderButtons">
                    <Button text="Geliefert buchen" icon="sap-icon://accept" type="Accept" enabled="{canComplete}" press=".onCompleteOrder" />
                    <Button text="Stornieren" icon="sap-icon://decline" type="Reject" enabled="{canCancel}" press=".onCancelOrder" />
                  </HBox>
                </VBox>
              </CustomListItem>
            </List>
            <Panel headerText="Beschaffungsprozess" class="processPanel">
              <content>
                <Text text="1. Bestand gegen Mindestbestand prüfen" />
                <Text text="2. Offene Bestellungen nach Dringlichkeit und Liefertermin sortieren" />
                <Text text="3. Bestellung als offenen Vorgang erfassen" />
                <Text text="4. Wareneingang buchen oder Bestellung stornieren" />
                <Text text="5. Kennzahlen für Managemententscheidung bereitstellen" />
              </content>
            </Panel>
          </HBox>
        </content>
      </Panel>
    </content>
  </Page>
</mvc:View>
