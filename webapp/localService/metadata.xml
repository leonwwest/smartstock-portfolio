<?xml version="1.0" encoding="UTF-8"?>
<edmx:Edmx
  Version="1.0"
  xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
  <edmx:DataServices
    m:DataServiceVersion="2.0"
    xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
    <Schema
      Namespace="SmartStockService"
      xmlns="http://schemas.microsoft.com/ado/2008/09/edm"
      xmlns:sap="http://www.sap.com/Protocols/SAPData">
      <EntityType Name="Product" sap:content-version="1">
        <Key>
          <PropertyRef Name="ProductID" />
        </Key>
        <Property Name="ProductID" Type="Edm.String" Nullable="false" MaxLength="10" sap:label="Produkt-ID" />
        <Property Name="Name" Type="Edm.String" Nullable="false" MaxLength="80" sap:label="Produkt" />
        <Property Name="Category" Type="Edm.String" Nullable="false" MaxLength="40" sap:label="Kategorie" />
        <Property Name="Stock" Type="Edm.Int32" Nullable="false" sap:label="Bestand" />
        <Property Name="MinStock" Type="Edm.Int32" Nullable="false" sap:label="Mindestbestand" />
        <Property Name="Price" Type="Edm.Decimal" Nullable="false" Precision="13" Scale="2" sap:unit="Currency" sap:label="Preis" />
        <Property Name="Currency" Type="Edm.String" Nullable="false" MaxLength="3" sap:semantics="currency-code" sap:label="Währung" />
        <Property Name="Sold" Type="Edm.Int32" Nullable="false" sap:label="Verkauft" />
        <Property Name="Status" Type="Edm.String" Nullable="false" MaxLength="20" sap:label="Status" />
        <NavigationProperty Name="ToOrders" Relationship="SmartStockService.ProductOrder" FromRole="FromProduct" ToRole="ToOrders" />
      </EntityType>

      <EntityType Name="Order" sap:content-version="1">
        <Key>
          <PropertyRef Name="OrderID" />
        </Key>
        <Property Name="OrderID" Type="Edm.String" Nullable="false" MaxLength="10" sap:label="Bestell-ID" />
        <Property Name="ProductID" Type="Edm.String" Nullable="false" MaxLength="10" sap:label="Produkt-ID" />
        <Property Name="ProductName" Type="Edm.String" Nullable="false" MaxLength="80" sap:label="Produkt" />
        <Property Name="Quantity" Type="Edm.Int32" Nullable="false" sap:label="Menge" />
        <Property Name="Status" Type="Edm.String" Nullable="false" MaxLength="20" sap:label="Bestellstatus" />
        <Property Name="CreatedAt" Type="Edm.DateTime" Nullable="false" sap:display-format="Date" sap:label="Anlagedatum" />
        <Property Name="ExpectedAt" Type="Edm.DateTime" Nullable="false" sap:display-format="Date" sap:label="Erwarteter Liefertermin" />
        <Property Name="Supplier" Type="Edm.String" Nullable="false" MaxLength="80" sap:label="Lieferant" />
        <NavigationProperty Name="ToProduct" Relationship="SmartStockService.ProductOrder" FromRole="ToOrders" ToRole="FromProduct" />
      </EntityType>

      <Association Name="ProductOrder">
        <End Type="SmartStockService.Product" Multiplicity="1" Role="FromProduct" />
        <End Type="SmartStockService.Order" Multiplicity="*" Role="ToOrders" />
        <ReferentialConstraint>
          <Principal Role="FromProduct">
            <PropertyRef Name="ProductID" />
          </Principal>
          <Dependent Role="ToOrders">
            <PropertyRef Name="ProductID" />
          </Dependent>
        </ReferentialConstraint>
      </Association>

      <EntityContainer Name="SmartStockService_Entities" m:IsDefaultEntityContainer="true" sap:supported-formats="atom json">
        <EntitySet Name="ProductSet" EntityType="SmartStockService.Product" sap:content-version="1" />
        <EntitySet Name="OrderSet" EntityType="SmartStockService.Order" sap:content-version="1" />
        <AssociationSet Name="ProductOrderSet" Association="SmartStockService.ProductOrder">
          <End EntitySet="ProductSet" Role="FromProduct" />
          <End EntitySet="OrderSet" Role="ToOrders" />
        </AssociationSet>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
